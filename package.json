{
  "name": "maxystudio",
  "productName": "MaxyStudio",
  "version": "2.14.0",
  "description": "MaxyStudio : un moteur de jeu 2D, 3D et d'applications où le code s'écrit en ScratchCode (blocs Scratch en texte).",
  "main": "main.js",
  "author": "ScratchCode",
  "license": "MIT",
  "homepage": "https://scratchcode.web.app",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "monaco-editor": "0.52.2",
    "three": "0.169.0"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "app.web.scratchcode.studio",
    "productName": "MaxyStudio",
    "artifactName": "MaxyStudio-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "templates.js",
      "mcp-server.js",
      "maxy-tools.js",
      "maxy-ai.js",
      "export/**",
      "renderer/**",
      "engine/**",
      "node_modules/monaco-editor/min/**",
      "node_modules/three/build/**",
      "plugins-catalog/**",
      "library/**",
      "vendor/**",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "maxycode",
        "name": "Projet MaxyStudio",
        "role": "Editor"
      },
      {
        "ext": "scratchcode",
        "name": "Ancien projet MaxyStudio",
        "role": "Editor"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MaxyStudio-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MaxyStudio",
      "artifactName": "MaxyStudio-Setup.${ext}"
    },
    "msi": {
      "artifactName": "MaxyStudio.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": "-",
      "artifactName": "MaxyStudio-mac-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "maintainer": "ScratchCode <contact@scratchcode.web.app>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MaxyStudio-linux-${arch}.${ext}"
    }
  },
  "repository": "https://github.com/luciencard/maxystudio"
}
